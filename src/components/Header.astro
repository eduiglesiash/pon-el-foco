---
import { SECCIONES } from "../data/navegacion";
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/?$/, "/");

// Entrada del menú y barra bajo el texto de la sección activa (forma, no solo color)
const ITEM =
  "relative flex min-h-11 items-center whitespace-nowrap rounded-full px-3 text-[.95rem] font-bold text-ink no-underline transition-colors hover:bg-sunk md:text-[.98rem]";
const ACTIVO =
  "after:absolute after:inset-x-3 after:bottom-1.5 after:h-1 after:-rotate-1 after:rounded-[2px_5px_3px_6px] after:bg-ink";
---

<header class="relative z-50 border-b border-line bg-bg/85 text-ink backdrop-blur-lg md:sticky md:top-[env(safe-area-inset-top,0px)]" style="view-transition-name: cabecera">
  <div class="wrap-wide flex flex-wrap items-center gap-x-2 gap-y-0 py-1.5 md:gap-x-4 md:py-2">
    <a
      href="/"
      aria-current={path === "/" ? "page" : undefined}
      class="flex min-h-11 items-center gap-2 font-display text-label font-extrabold tracking-[-0.02em] text-ink no-underline md:gap-2.5 md:text-title"
    >
      <!-- Pictograma: el indicador de foco de la propia web (anillo amarillo y tinta) alrededor de un punto -->
      <svg class="size-7 flex-none md:size-8" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="2" y="2" width="28" height="28" rx="8" fill="none" stroke="var(--ink)" stroke-width="3"></rect>
        <rect x="5" y="5" width="22" height="22" rx="5" fill="none" stroke="var(--mark)" stroke-width="3"></rect>
        <circle cx="16" cy="16" r="5" fill="var(--ink)"></circle>
      </svg>
      <span class="flex flex-col leading-tight">
        Pon el foco
        <span class="hidden font-body text-caption font-semibold tracking-normal text-muted sm:block">Accesibilidad web y WCAG en español</span>
      </span>
    </a>
    <nav aria-label="Principal" class="relative order-last w-full md:order-none md:ml-auto md:w-auto">
      <ul class="-mx-2 -my-1 flex gap-0.5 overflow-x-auto px-2 py-2 pr-8 [mask-image:linear-gradient(to_right,black_calc(100%-2rem),transparent)] [scrollbar-width:none] md:mx-0 md:my-0 md:flex-wrap md:overflow-visible md:p-0 md:[mask-image:none] data-abierto:[mask-image:none]">
        {
          SECCIONES.map((s) => {
            if (s.hijos) {
              // Desplegable (patrón de divulgación): sin JavaScript queda el enlace; el script lo cambia por el botón.
              // El panel se ancla al <nav> en móvil para que el scroll horizontal de esta lista no lo recorte.
              const activa = s.hijos.some((h) => path.startsWith(h.href));
              return (
                <li class="md:relative" data-desplegable>
                  <a href={s.href} class:list={[ITEM, activa && ACTIVO]} data-sin-js>
                    {s.label}
                  </a>
                  <button
                    type="button"
                    hidden
                    aria-expanded="false"
                    aria-controls="nav-herramientas"
                    class:list={["group cursor-pointer gap-1 bg-transparent", ITEM, activa && ACTIVO]}
                  >
                    {s.label}
                    <Icon name="chevron-down" size={16} class="transition-transform group-aria-expanded:rotate-180 motion-reduce:transition-none" />
                  </button>
                  <ul
                    id="nav-herramientas"
                    hidden
                    class="absolute inset-x-0 top-full z-50 mt-1 rounded-2xl border border-edge bg-surface p-1.5 shadow-[0_12px_32px_-16px_var(--shadow)] md:right-auto md:left-0 md:min-w-max"
                  >
                    {s.hijos.map((h) => {
                      const current = path === h.href ? "page" : path.startsWith(h.href) ? "true" : undefined;
                      return (
                        <li>
                          <a href={h.href} aria-current={current} class:list={[ITEM, "rounded-xl", current && ACTIVO]}>
                            {h.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              );
            }
            // "page" en la página exacta; "true" en sus subpáginas (p. ej. un criterio concreto)
            const current = path === s.href ? "page" : path.startsWith(s.href) ? "true" : undefined;
            return (
              <li>
                <a href={s.href} aria-current={current} class:list={[ITEM, current && ACTIVO]}>
                  {s.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2 md:ml-0">
    <div role="group" aria-label="Tamaño del texto" class="flex items-center gap-1">
      <button
        type="button"
        id="txtDown"
        class="min-h-11 min-w-11 cursor-pointer rounded-full border border-edge bg-transparent font-bold text-ink transition-colors hover:bg-sunk disabled:cursor-not-allowed disabled:opacity-50"
      >A−<span class="sr-only"> Reducir tamaño del texto</span></button>
      <button
        type="button"
        id="txtUp"
        class="min-h-11 min-w-11 cursor-pointer rounded-full border border-edge bg-transparent font-bold text-ink transition-colors hover:bg-sunk disabled:cursor-not-allowed disabled:opacity-50"
      >A+<span class="sr-only"> Aumentar tamaño del texto</span></button>
    </div>
    <button
      type="button"
      id="themeToggle"
      aria-label="Modo oscuro"
      aria-pressed="false"
      class="group flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border border-edge bg-transparent text-ink transition-colors hover:bg-sunk"
    >
      <svg width="20" height="20" viewBox="0 0 22 22" aria-hidden="true">
        <path
          d="M18.5 13.2A7.8 7.8 0 1 1 8.8 3.5a6.2 6.2 0 0 0 9.7 9.7Z"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linejoin="round"
          class="group-aria-pressed:fill-current"></path>
      </svg>
    </button>
    </div>
  </div>
</header>

<script>
  /* Desplegable «Herramientas» (patrón de divulgación del W3C): el foco se queda en el botón al abrir */
  const caja = document.querySelector<HTMLElement>("[data-desplegable]");
  if (caja) {
    const boton = caja.querySelector("button")!;
    const panel = document.getElementById(boton.getAttribute("aria-controls")!)!;
    caja.querySelector<HTMLAnchorElement>("[data-sin-js]")!.hidden = true;
    boton.hidden = false;
    const abrir = (si: boolean) => {
      boton.setAttribute("aria-expanded", String(si));
      panel.hidden = !si;
      // La máscara del degradado de la lista también taparía el panel: se quita mientras está abierto
      caja.parentElement!.toggleAttribute("data-abierto", si);
    };
    boton.addEventListener("click", () => abrir(panel.hidden));
    caja.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) {
        abrir(false);
        boton.focus();
      }
    });
    // Salir con Tab. Solo si el foco va a otro elemento: Safari no enfoca al hacer clic y relatedTarget llega vacío.
    caja.addEventListener("focusout", (e) => {
      const destino = e.relatedTarget as Node | null;
      if (destino && !caja.contains(destino)) abrir(false);
    });
    document.addEventListener("click", (e) => {
      if (!caja.contains(e.target as Node)) abrir(false);
    });
  }

  /* Tamaño de texto */
  const sizes = [90, 100, 112.5, 125, 150, 175, 200];
  let si = 1;
  try {
    const v = Number(localStorage.getItem("ac-size"));
    if (sizes.includes(v)) si = sizes.indexOf(v);
  } catch {}
  const down = document.getElementById("txtDown") as HTMLButtonElement;
  const up = document.getElementById("txtUp") as HTMLButtonElement;
  function applySize() {
    document.documentElement.style.setProperty("--root-size", sizes[si] + "%");
    try {
      localStorage.setItem("ac-size", String(sizes[si]));
    } catch {}
    down.disabled = si === 0;
    up.disabled = si === sizes.length - 1;
  }
  down.addEventListener("click", () => {
    if (si > 0) { si--; applySize(); }
  });
  up.addEventListener("click", () => {
    if (si < sizes.length - 1) { si++; applySize(); }
  });
  applySize();

  /* Modo oscuro: botón conmutador. Sin elección guardada sigue la preferencia del sistema. */
  const themeBtn = document.getElementById("themeToggle") as HTMLButtonElement;
  const systemDark = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (document.documentElement.dataset.theme ?? (systemDark.matches ? "dark" : "light")) === "dark";
  const syncTheme = () => themeBtn.setAttribute("aria-pressed", String(isDark()));
  themeBtn.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("ac-theme", next);
    } catch {}
    syncTheme();
  });
  systemDark.addEventListener("change", syncTheme);
  syncTheme();
</script>
