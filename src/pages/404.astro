---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import { SECCIONES } from "../data/navegacion";

// Página para enlaces rotos: explica qué ha pasado y ofrece las secciones del sitio. No se indexa.
const destinos = [{ href: "/", label: "Inicio" }, ...SECCIONES.flatMap((s) => s.hijos ?? [s])];
---

<Layout title="Página no encontrada" description="Esta página no existe o ha cambiado de dirección." noindex>
  <PageHead title="No encontramos esta página">
    Puede que la dirección esté mal escrita o que la página haya cambiado de sitio. Desde aquí puedes seguir por cualquier
    sección.
  </PageHead>
  <div class="wrap pb-12">
    <nav aria-labelledby="t-secciones">
      <h2 id="t-secciones" class="mb-4 text-title">Secciones de Pon el foco</h2>
      <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          destinos.map((d) => (
            <li>
              <a
                href={d.href}
                class="flex min-h-11 items-center rounded-xl border border-edge px-4 py-2 font-bold text-ink no-underline hover:bg-sunk"
              >
                {d.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Layout>
